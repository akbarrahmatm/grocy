                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": ["user", "token"]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
